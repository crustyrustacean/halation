# Halation environment template — copy to .env and fill in.
# The app loads .env via dotenvy on startup (dev convenience).
# In production, set these as real environment variables instead
# (DO App Platform env vars / droplet service env).

# --- sqlx-cli (dev only) ---
DATABASE_URL=postgres://postgres:password@localhost:5433/halation

# --- application ---
APP_ENVIRONMENT=local
APP_APPLICATION__HOST=127.0.0.1
APP_APPLICATION__PORT=8000
APP_APPLICATION__BASE_URL=http://127.0.0.1:8000
# Registration is open by default in local; production.yaml closes it.
# APP_APPLICATION__REGISTRATION_OPEN=false

# --- database ---
APP_DATABASE__HOST=127.0.0.1
APP_DATABASE__PORT=5433
APP_DATABASE__USERNAME=postgres
APP_DATABASE__PASSWORD=password
APP_DATABASE__DATABASE_NAME=halation
APP_DATABASE__REQUIRE_SSL=false

# --- media storage ---
# memory = local dev; s3 = Cloudflare R2 (S3-compatible)
APP_STORAGE__BACKEND=memory
# APP_STORAGE__BACKEND=s3
# APP_STORAGE__R2__BUCKET=halation-media
# APP_STORAGE__R2__FS_ROOT=
# APP_STORAGE__R2__ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# APP_STORAGE__R2__ACCESS_KEY=<r2 access key id>
# APP_STORAGE__R2__SECRET_KEY=<r2 secret access key>

# --- reverse geocoding (Nominatim) ---
APP_GEOCODE__ENABLED=true
APP_GEOCODE__BASE_URL=https://nominatim.openstreetmap.org

# --- secrets (production: 64+ random bytes, set via real env) ---
APP_SECRETS__SESSION_SIGNING_KEY=dev-only-key-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- email (noop until Mailtrap lands) ---
APP_EMAIL__BACKEND=noop

# --- compose stack (droplet / deployment) — read by `docker compose` ---
DOMAIN=halation.photos
POSTGRES_PASSWORD=change-me
HALATION_SESSION_SIGNING_KEY=change-me-64-random-characters
