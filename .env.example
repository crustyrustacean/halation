# Halation environment template — copy to .env and fill in.
# The app loads .env via dotenvy on startup (dev convenience).
# In production on Fly.io, set secrets via `fly secrets set` (see docs/DEPLOYMENT.md).

# --- sqlx-cli (dev only) ---
DATABASE_URL=sqlite://data/halation.db

# --- application ---
APP_ENVIRONMENT=local
APP_APPLICATION__HOST=127.0.0.1
APP_APPLICATION__PORT=8000
APP_APPLICATION__BASE_URL=http://127.0.0.1:8000
# Registration is open by default in local; production.toml closes it.
# APP_APPLICATION__REGISTRATION_OPEN=false

# --- database (SQLite) ---
# Local dev defaults to data/halation.db; production on Fly.io uses /data/halation.db
# on a mounted persistent volume (see fly.toml [mounts]).
APP_DATABASE__PATH=data/halation.db

# --- media storage ---
# memory = local dev; s3 = Cloudflare R2 (S3-compatible)
APP_STORAGE__BACKEND=memory
# APP_STORAGE__BACKEND=s3
# APP_STORAGE__R2__BUCKET=halation-media
# APP_STORAGE__R2__FS_ROOT=
# APP_STORAGE__R2__ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# APP_STORAGE__R2__ACCESS_KEY=<r2 access key id>
# APP_STORAGE__R2__SECRET_KEY=<r2 secret access key>
#
# A note on the commented-out s3 lines: `cargo test` inherits whatever is
# exported in your shell, and an s3 backend here would send the suite's test
# uploads into a real bucket. The harness now forces `memory` and the app
# refuses to boot a test run with a remote backend, so this cannot silently
# happen — but if you ever see "refusing to start: storage.backend is s3
# while application.testing is true", this file is the thing to check.

# --- reverse geocoding (Nominatim) ---
APP_GEOCODE__ENABLED=true
APP_GEOCODE__BASE_URL=https://nominatim.openstreetmap.org

# --- secrets (production: 64+ random bytes, set via real env) ---
APP_SECRETS__SESSION_SIGNING_KEY=dev-only-key-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- email (noop until Mailtrap lands) ---
APP_EMAIL__BACKEND=noop

# --- Reverse proxy ---------------------------------------------------------
# Halation sits behind Fly.io's edge proxy in production. Without this, the
# socket peer is always the proxy, so rate limiting keys on one address shared
# by every visitor in the world. Fly sets and overwrites `Fly-Client-IP` with
# the address it actually observed (and for other single-hop proxies, Halation
# falls back to the last entry of `X-Forwarded-For`).
#
# Shipped as `trusted_proxy = true` in configuration/production.toml, so this
# only needs setting when running behind a proxy in another environment.
#
# APP_APPLICATION__TRUSTED_PROXY=true
#
# Only set this when a proxy really is in front and really does overwrite the
# header. If a client can set it directly, every visitor gets their own
# forged rate-limit bucket.
